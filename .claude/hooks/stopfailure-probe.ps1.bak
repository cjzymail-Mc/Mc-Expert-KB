# stopfailure-probe.ps1
# DETECTION-ONLY probe for the StopFailure hook.
# 目的：回答一个问题——「黄字 Connection closed mid-response（重试耗尽的真中断）到底触不触发 StopFailure」。
# 它只往日志写一行，**不敲任何键、不发任何指令、不动会话**。验证完即可删。
# 日志：%USERPROFILE%\claude-stopfailure-probe.log（4 账号共享同一个文件，USERPROFILE 不随账号变）。

$ErrorActionPreference = 'SilentlyContinue'

$raw = [Console]::In.ReadToEnd()
$sid = ''; $cwd = ''; $tp = ''; $evt = ''
try {
  $j   = $raw | ConvertFrom-Json
  $sid = $j.session_id
  $cwd = $j.cwd
  $tp  = $j.transcript_path
  $evt = $j.hook_event_name
} catch {}

$ts = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'

# best-effort：从 transcript 尾部嗅一下错误类型/文本，帮我们认出这次是哪种错误（黄字 / 529 / …）。
# 拿不到也无所谓——只要日志里出现这一行，就证明 StopFailure 在这次中断触发了。
$snip = ''
try {
  if ($tp -and (Test-Path -LiteralPath $tp)) {
    $tail = Get-Content -LiteralPath $tp -Tail 8 -Encoding utf8
    $hit  = $tail | Select-String -Pattern 'overloaded|rate.?limit|server_error|Connection closed|incomplete|api.?error|"is_error"|"type"\s*:\s*"error"' -AllMatches
    if ($hit)            { $snip = ($hit.Line) -join ' | ' }
    elseif ($tail)       { $snip = ($tail | Select-Object -Last 1) }
  }
} catch {}
$snip = ($snip -replace '\s+', ' ').Trim()
if ($snip.Length -gt 300) { $snip = $snip.Substring(0, 300) }

$line = "$ts  FIRED  event=$evt  session=$sid  cwd=$cwd  tail=$snip"
$log  = Join-Path $env:USERPROFILE 'claude-stopfailure-probe.log'
try { Add-Content -LiteralPath $log -Value $line -Encoding utf8 } catch {}

# 探针不返回任何东西：StopFailure 的 stdout/exit code 本就被忽略，这里也无需输出。
exit 0
